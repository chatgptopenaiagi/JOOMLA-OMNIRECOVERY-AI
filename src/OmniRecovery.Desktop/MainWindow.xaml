<Window x:Class="OmniRecovery.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Joomla OmniRecovery AI · 1.0.0" Width="1440" Height="960" MinWidth="1080" MinHeight="740"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <SolidColorBrush x:Key="CanvasBrush" Color="#0C111D"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#101725"/>
  <SolidColorBrush x:Key="CardBrush" Color="#151E2E"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="#1C283B"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#2A3850"/>
  <SolidColorBrush x:Key="TextBrush" Color="#EDF2FB"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A2B1C8"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#8070FF"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#52D6AE"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#F8BD65"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#EF8191"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#92384B"/><Setter Property="Foreground" Value="White"/>
  </Style>
  <Style x:Key="NavButton" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="NavBorder" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
   <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="11,9"/>
   <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,9"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{DynamicResource CardBrush}"/>
   <Setter Property="AlternatingRowBackground" Value="{DynamicResource RaisedBrush}"/>
   <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="RowHeight" Value="42"/><Setter Property="ColumnHeaderHeight" Value="38"/>
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
   <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
   <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#51458C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Background="{DynamicResource CanvasBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="18,28,18,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="10,0,0,28">
     <Border Width="42" Height="42" Background="{DynamicResource AccentBrush}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,15"><TextBlock Text="O" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="OMNI RECOVERY" FontSize="17" FontWeight="Bold"/>
     <TextBlock Text="Joomla · Local recovery console" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel x:Name="Navigation" Grid.Row="1">
     <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,10"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="◈   Overview" Tag="Home" Click="Navigate_Click" AutomationProperties.Name="Overview"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="▦   Installations" Tag="Installations" Click="Navigate_Click" AutomationProperties.Name="Installations"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="▤   Database" Tag="Database" Click="Navigate_Click" AutomationProperties.Name="Database"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="♙   Accounts" Tag="Accounts" Click="Navigate_Click" AutomationProperties.Name="Accounts"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="◇   Recovery" Tag="Recovery" Click="Navigate_Click" AutomationProperties.Name="Recovery"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="⌘   SQL workbench" Tag="SQL" Click="Navigate_Click" AutomationProperties.Name="SQL workbench"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="✧   Assistant" Tag="Assistant" Click="Navigate_Click" AutomationProperties.Name="Assistant"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="☷   Evidence" Tag="Evidence" Click="Navigate_Click" AutomationProperties.Name="Evidence"/>
     <ToggleButton Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Navigate_Click" AutomationProperties.Name="Settings"/>
    </StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14">
     <StackPanel>
      <TextBlock Text="●  LOCAL BY DEFAULT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
      <TextBlock x:Name="ModeText" Text="Actions start only when you choose." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource CanvasBrush}" Padding="32,0">
    <DockPanel VerticalAlignment="Center">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Border Background="{DynamicResource RaisedBrush}" CornerRadius="15" Padding="12,6" Margin="12,0,0,0"><TextBlock x:Name="ConnectionBadge" Text="○  No database connection" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></Border>
      <Button Content="☀ / ☾" Click="Theme_Click" Margin="14,0,0,0" Padding="10,5" ToolTip="Switch appearance" AutomationProperties.Name="Switch light and dark theme"/>
     </StackPanel>
     <TextBlock x:Name="Breadcrumb" Text="Workspace  /  Overview" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="13"/>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,32,30" x:Name="PageScroller">
    <Grid x:Name="PageHost"/>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,0">
    <DockPanel VerticalAlignment="Center">
     <Button x:Name="CancelButton" Content="Cancel operation" Click="Cancel_Click" DockPanel.Dock="Right" Visibility="Collapsed" Padding="12,5" Margin="8,0,0,0"/>
     <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Width="95" Height="3" DockPanel.Dock="Right" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Margin="12,0"/>
     <TextBlock x:Name="StatusText" Text="Ready. Choose a scope to begin." FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
